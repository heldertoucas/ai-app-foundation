    },
    {
      "id": "futuro-digital", "name": "Futuro Digital", "blueprint": "website", "starter": false, "parity": "partial",
      "html": { "entries": ["public/html/kits/futuro-digital/index.html", "public/html/kits/futuro-digital/galeria.html"], "legacyEntries": ["public/html-kit/templates/du-futuro-digital.html", "public/html-kit/templates/du-futuro-digital-galeria.html"] },
      "react": { "routes": ["/futuro-digital", "/futuro-digital/galeria"], "entries": ["app/(brand)/futuro-digital/page.tsx", "app/(brand)/futuro-digital/galeria/page.tsx"], "legacyEntries": ["app/(site)/futuro-digital/page.tsx", "app/(site)/futuro-digital/galeria/page.tsx"] },
