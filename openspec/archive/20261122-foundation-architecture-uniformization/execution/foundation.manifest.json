      "moduleExceptions": [
        { "module": "auth-pin", "reason": "O Kit usa credenciais por perfil, hash e bloqueio temporário que o Module ainda não suporta" },
        { "module": "data-table", "reason": "A tabela do Kit tem ações por linha e renderização DOM segura desde WP-22" }
      ]
    },
    {
      "id": "website-starter", "name": "Website Starter", "blueprint": "website", "starter": true, "parity": "single-stack",
      "html": null,
